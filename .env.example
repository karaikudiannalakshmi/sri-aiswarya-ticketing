# Copy this file to .env and fill in your Firebase project values
# (Vercel: add these as plain env vars, NOT "Sensitive", so Vite can read them at build time)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Login IDs for the two roles. The app's Login screen only shows an
# Operator/Admin choice plus a password - nobody ever sees or types these.
# They just need to be unique, email-shaped strings for Firebase's login
# system to accept, e.g.:
#   VITE_ADMIN_EMAIL=admin@sri-aishwarya-ticketing.local
#   VITE_OPERATOR_EMAIL=operator@sri-aishwarya-ticketing.local
# Create both as Email/Password users in Firebase Authentication, and set
# each one's password there (not in this file). See README for the full
# setup, including the roles/{uid} document each account needs.
VITE_ADMIN_EMAIL=
VITE_OPERATOR_EMAIL=
