# Copy this file to .env and fill in your Firebase project values
# (Vercel: add these as plain env vars, NOT "Sensitive", so Vite can read them at build time)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shared app-level password (operators enter this to open the app)
VITE_APP_PASSWORD=temple123
